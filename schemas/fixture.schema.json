{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LiamCarPer/enterprise-detection-lab/main/schemas/fixture.schema.json",
  "title": "Detection fixture",
  "description": "Schema for detections/<domain>/<slug>/fixtures/*.json.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["event", "source", "synthetic"],
    "properties": {
      "event": {
        "type": "object"
      },
      "source": {
        "type": "string",
        "minLength": 2
      },
      "event_time": {
        "type": "string",
        "format": "date-time"
      },
      "synthetic": {
        "const": true
      },
      "note": {
        "type": "string"
      }
    }
  }
}
