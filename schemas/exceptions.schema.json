{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LiamCarPer/enterprise-detection-lab/main/schemas/exceptions.schema.json",
  "title": "Detection exception catalog",
  "description": "Schema for detections/exceptions.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "exceptions"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "detection_id",
          "type",
          "owner",
          "reason",
          "scope",
          "change_ticket",
          "created",
          "expires",
          "compensating_controls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EXC-(IDN|END|CLD|SAA|NET|K8S|AGT)-[0-9]{3}-[0-9]{3}$"
          },
          "detection_id": {
            "type": "string",
            "pattern": "^DET-(IDN|END|CLD|SAA|NET|K8S|AGT)-[0-9]{3}$"
          },
          "type": {
            "type": "string",
            "enum": ["query-exclusion", "review-only", "maintenance"]
          },
          "owner": {
            "type": "string",
            "minLength": 2
          },
          "reason": {
            "type": "string",
            "minLength": 20
          },
          "scope": {
            "type": "object",
            "minProperties": 1
          },
          "change_ticket": {
            "type": "string",
            "minLength": 3
          },
          "created": {
            "type": "string",
            "format": "date"
          },
          "expires": {
            "type": "string",
            "format": "date"
          },
          "compensating_controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
