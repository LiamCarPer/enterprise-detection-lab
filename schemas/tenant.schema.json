{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LiamCarPer/enterprise-detection-lab/main/schemas/tenant.schema.json",
  "title": "Tenant configuration",
  "description": "Schema for config/tenant.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "accepted_mail_domains"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "accepted_mail_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
      }
    },
    "approved_applications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "app_id",
          "display_name",
          "owner_organization_id",
          "publisher",
          "redirect_uris"
        ],
        "properties": {
          "app_id": {
            "type": "string",
            "minLength": 3
          },
          "display_name": {
            "type": "string",
            "minLength": 3
          },
          "owner_organization_id": {
            "type": "string",
            "minLength": 3
          },
          "publisher": {
            "type": "string",
            "minLength": 3
          },
          "redirect_uris": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 8
            }
          }
        }
      }
    },
    "publisher_reputation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organization_id",
          "publisher",
          "reputation"
        ],
        "properties": {
          "organization_id": {
            "type": "string",
            "minLength": 3
          },
          "publisher": {
            "type": "string",
            "minLength": 3
          },
          "reputation": {
            "type": "string",
            "enum": [
              "trusted",
              "neutral",
              "untrusted"
            ]
          }
        }
      }
    }
  }
}
