{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LiamCarPer/enterprise-detection-lab/main/schemas/metrics.schema.json",
  "title": "Detection metrics",
  "description": "Schema for detections/<domain>/<slug>/metrics.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detection_id",
    "measured_at",
    "sample_size",
    "precision",
    "recall",
    "false_positive_rate",
    "latency_ms_p50",
    "latency_ms_p95",
    "method",
    "limitations"
  ],
  "properties": {
    "detection_id": {
      "type": "string",
      "pattern": "^DET-(IDN|END|CLD|SAA|NET|K8S|AGT)-[0-9]{3}$"
    },
    "measured_at": {
      "type": "string",
      "format": "date-time"
    },
    "sample_size": {
      "type": "integer",
      "minimum": 1
    },
    "precision": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recall": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "false_positive_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "latency_ms_p50": {
      "type": "number",
      "minimum": 0
    },
    "latency_ms_p95": {
      "type": "number",
      "minimum": 0
    },
    "method": {
      "type": "string",
      "minLength": 5
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    }
  }
}
