{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LiamCarPer/enterprise-detection-lab/main/schemas/investigation.schema.json",
  "title": "Investigation metadata",
  "description": "Schema for meta.yaml in an investigation package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "version",
    "status",
    "domains",
    "scenario",
    "hypothesis",
    "detections",
    "owner",
    "evidence",
    "timeline",
    "lessons"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^INV-[0-9]{3}$",
      "description": "Stable investigation ID, for example INV-001."
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "tested", "published", "retired"]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["identity", "endpoint", "cloud", "saas", "network", "kubernetes", "agent"]
      }
    },
    "scenario": {
      "type": "string",
      "minLength": 20
    },
    "hypothesis": {
      "type": "string",
      "minLength": 20
    },
    "detections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^DET-(IDN|END|CLD|SAA|NET|K8S|AGT)-[0-9]{3}$"
      }
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "executive_summary": {
      "type": "string",
      "minLength": 20
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "source", "path", "provenance"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "type": {
            "type": "string",
            "enum": ["event", "log", "query_result", "packet", "identity", "cloud", "screenshot", "note"]
          },
          "source": {
            "type": "string",
            "minLength": 2
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "minLength": 5
          },
          "description": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "event", "source"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "event": {
            "type": "string",
            "minLength": 5
          },
          "source": {
            "type": "string",
            "minLength": 2
          },
          "evidence_id": {
            "type": "string"
          }
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "response": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
