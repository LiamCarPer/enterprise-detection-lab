{
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "source": "entra-audit"
          }
        },
        {
          "term": {
            "approved_app": false
          }
        },
        {
          "term": {
            "result": "success"
          }
        },
        {
          "terms": {
            "action": [
              "Consent to application",
              "Add OAuth2PermissionGrant",
              "Add delegated permission grant"
            ]
          }
        },
        {
          "bool": {
            "should": [
              {
                "term": {
                  "consent_type": "admin"
                }
              },
              {
                "term": {
                  "consent_type": "tenant"
                }
              },
              {
                "term": {
                  "tenant_wide": true
                }
              }
            ],
            "minimum_should_match": 1
          }
        },
        {
          "bool": {
            "should": [
              {
                "term": {
                  "publisher_verified": false
                }
              },
              {
                "term": {
                  "redirect_uri_trusted": false
                }
              },
              {
                "term": {
                  "publisher_reputation": "untrusted"
                }
              }
            ],
            "minimum_should_match": 1
          }
        }
      ]
    }
  }
}
