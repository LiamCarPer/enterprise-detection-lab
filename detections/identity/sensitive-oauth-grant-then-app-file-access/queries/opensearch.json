{
  "query": {
    "bool": {
      "should": [
        {
          "bool": {
            "filter": [
              { "term": { "source": "entra-audit" } },
              { "term": { "result": "success" } },
              { "term": { "approved_app": false } },
              { "term": { "sensitive_scope": true } },
              { "term": { "scope_categories": "files" } },
              { "term": { "offline_access": true } },
              {
                "terms": {
                  "action": [
                    "Consent to application",
                    "Add OAuth2PermissionGrant",
                    "Add delegated permission grant"
                  ]
                }
              }
            ]
          }
        },
        {
          "bool": {
            "filter": [
              { "term": { "source": "m365-audit" } },
              {
                "terms": {
                  "action": [
                    "FileAccessed",
                    "FileDeleted",
                    "FileDownloaded",
                    "FileModified",
                    "FilePreviewed",
                    "FileUploaded"
                  ]
                }
              },
              { "term": { "result": "success" } },
              { "term": { "app_access": true } }
            ]
          }
        }
      ],
      "minimum_should_match": 1
    }
  }
}
