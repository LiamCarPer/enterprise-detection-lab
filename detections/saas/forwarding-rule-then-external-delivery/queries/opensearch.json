{
  "query": {
    "bool": {
      "should": [
        {
          "bool": {
            "filter": [
              { "term": { "source": "m365-audit" } },
              {
                "terms": {
                  "action": ["New-InboxRule", "Set-InboxRule", "UpdateInboxRules"]
                }
              },
              { "term": { "result": "success" } },
              { "term": { "forward_external": true } }
            ]
          }
        },
        {
          "bool": {
            "filter": [
              { "term": { "source": "exchange-message-trace" } },
              { "term": { "event_class": "deliver" } },
              { "term": { "external_recipient": true } },
              { "term": { "result": "success" } }
            ]
          }
        }
      ],
      "minimum_should_match": 1
    }
  }
}
