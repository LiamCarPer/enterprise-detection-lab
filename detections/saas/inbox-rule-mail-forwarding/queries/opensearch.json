{
  "query": {
    "bool": {
      "filter": [
        { "term": { "source": "m365-audit" } },
        { "terms": { "action": ["New-InboxRule", "Set-InboxRule"] } },
        { "term": { "result": "success" } },
        { "exists": { "field": "forward_to" } }
      ],
      "must_not": [
        { "term": { "forward_domain": "example.test" } }
      ]
    }
  }
}
