# Local lab ports. All services bind to 127.0.0.1.
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601
KUSTO_PORT=18080

# Resources
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
KUSTO_MEMORY=4g

# CLI endpoints
EDL_OPENSEARCH_URL=http://127.0.0.1:9200
EDL_DASHBOARDS_URL=http://127.0.0.1:5601
EDL_KUSTO_URL=http://127.0.0.1:18080
EDL_KUSTO_DB=NetDefaultDB
EDL_DUCKDB_PATH=lab/data/duckdb/edl.duckdb
