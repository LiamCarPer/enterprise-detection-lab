{
  "index_patterns": ["edl-findings-*"],
  "priority": 100,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 0
      }
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "detection_id": { "type": "keyword" },
        "title": { "type": "keyword" },
        "severity": { "type": "keyword" },
        "status": { "type": "keyword" },
        "source": { "type": "keyword" },
        "host": { "type": "keyword" },
        "user": { "type": "keyword" },
        "event_time": { "type": "date" },
        "ingest_time": { "type": "date" },
        "evidence": { "type": "object", "enabled": false }
      }
    }
  }
}
