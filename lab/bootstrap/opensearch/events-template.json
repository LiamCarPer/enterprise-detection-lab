{
  "index_patterns": ["edl-events-*"],
  "priority": 100,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 0
      }
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": { "type": "date" },
        "event_time": { "type": "date" },
        "ingest_time": { "type": "date" },
        "source": { "type": "keyword" },
        "event_class": { "type": "keyword" },
        "schema_version": { "type": "keyword" },
        "host": { "type": "keyword" },
        "user": { "type": "keyword" },
        "src_ip": { "type": "keyword" },
        "action": { "type": "keyword" },
        "result": { "type": "keyword" },
        "app": { "type": "keyword" },
        "auth_requirement": { "type": "keyword" },
        "is_interactive": { "type": "boolean" },
        "conditional_access_status": { "type": "keyword" },
        "risk_level": { "type": "keyword" },
        "event_id": { "type": "keyword" },
        "event_code": { "type": "integer" },
        "service": { "type": "keyword" },
        "account": { "type": "keyword" },
        "region": { "type": "keyword" },
        "flow_id": { "type": "keyword" },
        "network_log": { "type": "keyword" },
        "bytes_sent": { "type": "long" },
        "bytes_received": { "type": "long" },
        "identity_type": { "type": "keyword" },
        "identity_arn": { "type": "keyword" },
        "error_code": { "type": "keyword" },
        "user_agent": { "type": "keyword" },
        "workload": { "type": "keyword" },
        "record_type": { "type": "keyword" },
        "object_id": { "type": "keyword" },
        "rule_name": { "type": "keyword" },
        "forward_to": { "type": "keyword" },
        "forward_domain": { "type": "keyword" },
        "forward_domains": { "type": "keyword" },
        "forward_external": { "type": "boolean" },
        "mailbox": { "type": "keyword" },
        "delegate": { "type": "keyword" },
        "access_rights": { "type": "keyword" },
        "organization": { "type": "keyword" },
        "repository": { "type": "keyword" },
        "target_user": { "type": "keyword" },
        "role": { "type": "keyword" },
        "namespace": { "type": "keyword" },
        "pod": { "type": "keyword" },
        "container": { "type": "keyword" },
        "resource_name": { "type": "keyword" },
        "response_status": { "type": "integer" },
        "audit_stage": { "type": "keyword" },
        "privileged": { "type": "boolean" },
        "priority": { "type": "keyword" },
        "logon_type": { "type": "integer" },
        "status": { "type": "keyword" },
        "subject_user": { "type": "keyword" },
        "service_name": { "type": "keyword" },
        "task_name": { "type": "keyword" },
        "process": {
          "type": "object",
          "properties": {
            "name": { "type": "keyword" },
            "image": { "type": "keyword" },
            "command_line": {
              "type": "text",
              "fields": {
                "keyword": { "type": "keyword", "ignore_above": 4096 }
              }
            },
            "guid": { "type": "keyword" },
            "id": { "type": "integer" },
            "parent_name": { "type": "keyword" },
            "parent_image": { "type": "keyword" },
            "parent_command_line": {
              "type": "text",
              "fields": {
                "keyword": { "type": "keyword", "ignore_above": 4096 }
              }
            }
          }
        },
        "network": {
          "type": "object",
          "properties": {
            "source_ip": { "type": "keyword" },
            "source_port": { "type": "integer" },
            "destination_ip": { "type": "keyword" },
            "destination_port": { "type": "integer" },
            "protocol": { "type": "keyword" },
            "app_protocol": { "type": "keyword" }
          }
        },
        "file": {
          "type": "object",
          "properties": {
            "target_filename": { "type": "keyword" }
          }
        },
        "registry": {
          "type": "object",
          "properties": {
            "target_object": { "type": "keyword" },
            "details": { "type": "keyword" }
          }
        },
        "dns": {
          "type": "object",
          "properties": {
            "query_name": { "type": "keyword" },
            "query_results": { "type": "keyword" },
            "query_type": { "type": "keyword" },
            "query_length": { "type": "integer" }
          }
        },
        "http": {
          "type": "object",
          "properties": {
            "host": { "type": "keyword" },
            "uri": { "type": "keyword" },
            "method": { "type": "keyword" },
            "status": { "type": "integer" },
            "user_agent": { "type": "keyword" }
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "sni": { "type": "keyword" },
            "version": { "type": "keyword" },
            "cipher": { "type": "keyword" }
          }
        },
        "alert": {
          "type": "object",
          "properties": {
            "signature": {
              "type": "text",
              "fields": {
                "keyword": { "type": "keyword", "ignore_above": 1024 }
              }
            },
            "category": { "type": "keyword" },
            "severity": { "type": "integer" }
          }
        },
        "dedup_origin": { "type": "keyword" },
        "dedup_key": { "type": "object", "enabled": false },
        "device": {
          "type": "object",
          "properties": {
            "os": { "type": "keyword" },
            "browser": { "type": "keyword" }
          }
        },
        "resource": {
          "type": "object",
          "properties": {
            "name": { "type": "keyword" },
            "type": { "type": "keyword" },
            "count": { "type": "integer" }
          }
        },
        "detection_id": { "type": "keyword" },
        "raw": { "type": "object", "enabled": false },
        "unmapped": { "type": "object", "enabled": false }
      }
    }
  }
}
